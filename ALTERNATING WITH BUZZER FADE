int Led1 = 2;
int Led2 = 3;
int Led3 = 4;
int Led4 = 5;
int Led5 = 6;
int Led6 = 7;
int Buzzer = 8;

void setup()
{
  pinMode(Led1, OUTPUT);
  pinMode(Led2, OUTPUT);
  pinMode(Led3, OUTPUT);
  pinMode(Led4, OUTPUT);
  pinMode(Led5, OUTPUT);
  pinMode(Led6, OUTPUT);
  pinMode(Buzzer, OUTPUT);
}

void FadingPapart(){
  delay(100);
for (int FadeValue = 0; FadeValue <= 255; FadeValue += 5) {
 analogWrite(Led1, FadeValue);
      analogWrite(Led2, FadeValue);
      analogWrite(Led3, FadeValue);
      analogWrite(Led4, FadeValue);
      analogWrite(Led5, FadeValue);
      analogWrite(Led6, FadeValue);

    int Frequency = map(FadeValue, 0, 255, 75, 100);
    tone(Buzzer, Frequency);

    delay(20);
  }

  delay(150);

  // Fade out
  for (int FadeValue = 255; FadeValue >= 0; FadeValue -= 5) {
 analogWrite(Led1, FadeValue);
      analogWrite(Led2, FadeValue);
      analogWrite(Led3, FadeValue);
      analogWrite(Led4, FadeValue);
      analogWrite(Led5, FadeValue);
      analogWrite(Led6, FadeValue);

    int Frequency = map(FadeValue, 0, 255, 0, 100);
    tone(Buzzer, Frequency);

    delay(20);
  }

  noTone(Buzzer);
  delay(700);
}
    

void loop()
{
  tone(Buzzer, 200);
  digitalWrite(Led1, HIGH);
  digitalWrite(Led2, LOW);
  delay(200);
  tone(Buzzer, 175);
  digitalWrite(Led2, HIGH);
  digitalWrite(Led1, LOW);
  delay(100);
  tone(Buzzer, 150);
    digitalWrite(Led3, HIGH);
  digitalWrite(Led2, LOW);
  delay(100);
  tone(Buzzer, 125);
    digitalWrite(Led4, HIGH);
  digitalWrite(Led3, LOW);
  delay(100);
  tone(Buzzer, 100);
    digitalWrite(Led5, HIGH);
  digitalWrite(Led4, LOW);
  delay(100);
  tone(Buzzer, 75);
  digitalWrite(Led6, HIGH);
  digitalWrite(Led5, LOW);
  delay(200);
  tone(Buzzer, 100);
  digitalWrite(Led5, HIGH);
  digitalWrite(Led6, LOW);
  delay(100);
  tone(Buzzer, 125);
  digitalWrite(Led4, HIGH);
  digitalWrite(Led5, LOW);
  delay(100);
  tone(Buzzer, 150);
  digitalWrite(Led3, HIGH);
  digitalWrite(Led4, LOW);
  delay(100);
  tone(Buzzer, 175);
  digitalWrite(Led2, HIGH);
  digitalWrite(Led3, LOW);
  delay(100);
  digitalWrite(Led2, LOW);
  delay(100);
  FadingPapart();
}
