
#define BUZZER_PIN 8

// Note frequencies
#define NOTE_C5  523
#define NOTE_D5  587
#define NOTE_E5  659
#define NOTE_F5  698
#define NOTE_G5  784
#define NOTE_A5  880
#define NOTE_AS5 932
#define NOTE_C6  1047
#define REST     0

int tempo = 140;

// We Wish You a Merry Christmas
int melody[] = {
  NOTE_C5,4,
  NOTE_F5,4, NOTE_F5,8, NOTE_G5,8, NOTE_F5,8, NOTE_E5,8,
  NOTE_D5,4, NOTE_D5,4, NOTE_D5,4,
  NOTE_G5,4, NOTE_G5,8, NOTE_A5,8, NOTE_G5,8, NOTE_F5,8,
  NOTE_E5,4, NOTE_C5,4, NOTE_C5,4,
  NOTE_A5,4, NOTE_A5,8, NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F5,4, NOTE_D5,4, NOTE_C5,8, NOTE_C5,8,
  NOTE_D5,4, NOTE_G5,4, NOTE_E5,4,

  NOTE_F5,2, NOTE_C5,4,
  NOTE_F5,4, NOTE_F5,8, NOTE_G5,8, NOTE_F5,8, NOTE_E5,8,
  NOTE_D5,4, NOTE_D5,4, NOTE_D5,4,
  NOTE_G5,4, NOTE_G5,8, NOTE_A5,8, NOTE_G5,8, NOTE_F5,8,
  NOTE_E5,4, NOTE_C5,4, NOTE_C5,4,
  NOTE_A5,4, NOTE_A5,8, NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F5,4, NOTE_D5,4, NOTE_C5,8, NOTE_C5,8,
  NOTE_D5,4, NOTE_G5,4, NOTE_E5,4,
  NOTE_F5,2, NOTE_C5,4,

  NOTE_F5,4, NOTE_F5,4, NOTE_F5,4,
  NOTE_E5,2, NOTE_E5,4,
  NOTE_F5,4, NOTE_E5,4, NOTE_D5,4,
  NOTE_C5,2, NOTE_A5,4,
  NOTE_AS5,4, NOTE_A5,4, NOTE_G5,4,
  NOTE_C6,4, NOTE_C5,4, NOTE_C5,8, NOTE_C5,8,
  NOTE_D5,4, NOTE_G5,4, NOTE_E5,4,
  NOTE_F5,2, NOTE_C5,4,

  NOTE_F5,4, NOTE_F5,8, NOTE_G5,8, NOTE_F5,8, NOTE_E5,8,
  NOTE_D5,4, NOTE_D5,4, NOTE_D5,4,
  NOTE_G5,4, NOTE_G5,8, NOTE_A5,8, NOTE_G5,8, NOTE_F5,8,
  NOTE_E5,4, NOTE_C5,4, NOTE_C5,4,
  NOTE_A5,4, NOTE_A5,8, NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F5,4, NOTE_D5,4, NOTE_C5,8, NOTE_C5,8,
  NOTE_D5,4, NOTE_G5,4, NOTE_E5,4,
  NOTE_F5,2, REST,4
};

// Calculate the number of notes
const int totalNotes =
  sizeof(melody) / sizeof(melody[0]) / 2;

const int wholenote = (60000L * 4) / 140;

// Six PWM LEDs
int leds[] = {3, 5, 6, 9, 10, 11};
const int ledCount = 6;

// LED sequence
int ledPosition = 0;
int ledDirection = 1;

// Music timing
int currentNote = 0;
unsigned long previousNoteTime = 0;
unsigned long noteDuration = 0;
bool songFinished = false;

void setup() {
  pinMode(BUZZER_PIN, OUTPUT);

  for (int i = 0; i < ledCount; i++) {
    pinMode(leds[i], OUTPUT);
    analogWrite(leds[i], 0);
  }

  // Start with the first note and first LED
  playNextNote();
}

void loop() {
  if (songFinished) {
    return;
  }

  unsigned long elapsed = millis() - previousNoteTime;

  // Move to the next note when this one finishes
  if (elapsed >= noteDuration) {
    noTone(BUZZER_PIN);

    // Turn off LEDs before changing position
    for (int i = 0; i < ledCount; i++) {
      analogWrite(leds[i], 0);
    }

    // Reverse direction at the ends
    if (ledPosition >= ledCount - 1) {
      ledDirection = -1;
    } else if (ledPosition <= 0) {
      ledDirection = 1;
    }

    ledPosition += ledDirection;

    playNextNote();
    return;
  }

  // Fade during 90% of the note
  unsigned long fadeTime = noteDuration * 9UL / 10UL;
  int brightness = 0;

  if (fadeTime > 1 && elapsed < fadeTime / 2) {
    brightness = map(
      elapsed, 0, fadeTime / 2, 0, 255
    );
  } else if (fadeTime > 1 && elapsed < fadeTime) {
    brightness = map(
      elapsed, fadeTime / 2, fadeTime, 255, 0
    );
  }

  // Only the current LED fades
  for (int i = 0; i < ledCount; i++) {
    if (i == ledPosition) {
      analogWrite(leds[i], brightness);
    } else {
      analogWrite(leds[i], 0);
    }
  }
}

void playNextNote() {
  // Stop after the final note
  if (currentNote >= totalNotes) {
    noTone(BUZZER_PIN);

    for (int i = 0; i < ledCount; i++) {
      analogWrite(leds[i], 0);
    }

    songFinished = true;
    return;
  }

  // Read the next pitch and its duration divider
  int pitch = melody[currentNote * 2];
  int divider = melody[currentNote * 2 + 1];

  // Calculate duration in milliseconds
  if (divider > 0) {
    noteDuration = wholenote / divider;
  } else {
    noteDuration = (wholenote / abs(divider)) * 1.5;
  }

  // Record the start time of this note
  previousNoteTime = millis();

  // Play the note, or remain silent for a rest
  if (pitch == REST) {
    noTone(BUZZER_PIN);
  } else {
    tone(BUZZER_PIN, pitch);
  }

  currentNote++;
}
