#define BUZZER_PIN 8

// Christmas melody notes
#define NOTE_C5  523
#define NOTE_D5  587
#define NOTE_E5  659
#define NOTE_F5  698
#define NOTE_G5  784
#define NOTE_A5  880
#define NOTE_AS5 932
#define NOTE_C6  1047
#define REST     0

int tempo = 140;

int melody[] = {
  NOTE_C5,4,
  NOTE_F5,4, NOTE_F5,8, NOTE_G5,8, NOTE_F5,8, NOTE_E5,8,
  NOTE_D5,4, NOTE_D5,4, NOTE_D5,4,
  NOTE_G5,4, NOTE_G5,8, NOTE_A5,8, NOTE_G5,8, NOTE_F5,8,
  NOTE_E5,4, NOTE_C5,4, NOTE_C5,4,
  NOTE_A5,4, NOTE_A5,8, NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F5,4, NOTE_D5,4, NOTE_C5,8, NOTE_C5,8,
  NOTE_D5,4, NOTE_G5,4, NOTE_E5,4,

  NOTE_F5,2, NOTE_C5,4,
  NOTE_F5,4, NOTE_F5,8, NOTE_G5,8, NOTE_F5,8, NOTE_E5,8,
  NOTE_D5,4, NOTE_D5,4, NOTE_D5,4,
  NOTE_G5,4, NOTE_G5,8, NOTE_A5,8, NOTE_G5,8, NOTE_F5,8,
  NOTE_E5,4, NOTE_C5,4, NOTE_C5,4,
  NOTE_A5,4, NOTE_A5,8, NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F5,4, NOTE_D5,4, NOTE_C5,8, NOTE_C5,8,
  NOTE_D5,4, NOTE_G5,4, NOTE_E5,4,
  NOTE_F5,2, NOTE_C5,4,

  NOTE_F5,4, NOTE_F5,4, NOTE_F5,4,
  NOTE_E5,2, NOTE_E5,4,
  NOTE_F5,4, NOTE_E5,4, NOTE_D5,4,
  NOTE_C5,2, NOTE_A5,4,
  NOTE_AS5,4, NOTE_A5,4, NOTE_G5,4,
  NOTE_C6,4, NOTE_C5,4, NOTE_C5,8, NOTE_C5,8,
  NOTE_D5,4, NOTE_G5,4, NOTE_E5,4,
  NOTE_F5,2, NOTE_C5,4,

  NOTE_F5,4, NOTE_F5,8, NOTE_G5,8, NOTE_F5,8, NOTE_E5,8,
  NOTE_D5,4, NOTE_D5,4, NOTE_D5,4,
  NOTE_G5,4, NOTE_G5,8, NOTE_A5,8, NOTE_G5,8, NOTE_F5,8,
  NOTE_E5,4, NOTE_C5,4, NOTE_C5,4,
  NOTE_A5,4, NOTE_A5,8, NOTE_AS5,8, NOTE_A5,8, NOTE_G5,8,
  NOTE_F5,4, NOTE_D5,4, NOTE_C5,8, NOTE_C5,8,
  NOTE_D5,4, NOTE_G5,4, NOTE_E5,4,
  NOTE_F5,2, REST,4
};

int totalNotes = sizeof(melody) / sizeof(melody[0]) / 2;
int wholenote = (60000 * 4) / tempo;

int leds[] = {2, 3, 4, 5, 6, 7};
int ledCount = 6;

int ledPosition = 0;
int ledDirection = 1;

unsigned long previousLedTime = 0;
const unsigned long ledInterval = 30;

unsigned long previousNoteTime = 0;
int currentNote = 0;
bool playingNote = false;
bool songFinished = false;

unsigned long noteDuration = 0;

void setup() {
  pinMode(BUZZER_PIN, OUTPUT);

  for (int i = 0; i < ledCount; i++) {
    pinMode(leds[i], OUTPUT);
  }

  playNextNote();
}

void loop() {
  unsigned long currentTime = millis();

  // LED animation runs independently of the music
  if (currentTime - previousLedTime >= ledInterval) {
    previousLedTime = currentTime;

    for (int i = 0; i < ledCount; i++) {
      digitalWrite(leds[i], LOW);
    }

    digitalWrite(leds[ledPosition], HIGH);

    ledPosition += ledDirection;

    if (ledPosition >= ledCount - 1) {
      ledPosition = ledCount - 1;
      ledDirection = -1;
    } 
    else if (ledPosition <= 0) {
      ledPosition = 0;
      ledDirection = 1;
    }
  }

  // Move to the next musical note when its duration ends
  if (!songFinished &&
      currentTime - previousNoteTime >= noteDuration) {

    noTone(BUZZER_PIN);
    playNextNote();
  }
}

void playNextNote() {
  if (currentNote >= totalNotes) {
    noTone(BUZZER_PIN);
    songFinished = true;
    return;
  }

  int pitch = melody[currentNote * 2];
  int divider = melody[currentNote * 2 + 1];

  if (divider > 0) {
    noteDuration = wholenote / divider;
  } 
  else {
    noteDuration = (wholenote / abs(divider)) * 1.5;
  }

  previousNoteTime = millis();

  // Play the note for 90% of its duration
  if (pitch != REST) {
    tone(BUZZER_PIN, pitch, noteDuration * 0.9);
  }

  currentNote++;
}
