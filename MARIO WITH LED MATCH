int notes = sizeof(melody) / sizeof(melody[0]) / 2;
unsigned long wholenote = (60000UL * 4) / tempo;

int leds[] = {2, 3, 4, 5, 6, 7};
int ledCount = 6;

int ledPosition = 0;
int ledDirection = 1;

void setup() {
  pinMode(buzzer, OUTPUT);

  for (int i = 0; i < ledCount; i++) {
    pinMode(leds[i], OUTPUT);
    digitalWrite(leds[i], LOW);
  }

  for (int thisNote = 0; thisNote < notes * 2; thisNote += 2) {
    int pitch = melody[thisNote];
    int divider = melody[thisNote + 1];

    unsigned long noteDuration;

    if (divider > 0) {
      noteDuration = wholenote / divider;
    } else {
      noteDuration = (wholenote / abs(divider)) * 1.5;
    }

    // Turn off all LEDs
    for (int i = 0; i < ledCount; i++) {
      digitalWrite(leds[i], LOW);
    }

    // Light one LED for the current note
    digitalWrite(leds[ledPosition], HIGH);

    // Bounce between the six LEDs
    ledPosition += ledDirection;

    if (ledPosition >= ledCount - 1) {
      ledPosition = ledCount - 1;
      ledDirection = -1;
    } else if (ledPosition <= 0) {
      ledPosition = 0;
      ledDirection = 1;
    }

    // Play the note or remain silent during a rest
    if (pitch != REST) {
      tone(buzzer, pitch, noteDuration * 0.9);
    } else {
      noTone(buzzer);
    }

    delay(noteDuration);
    noTone(buzzer);
  }

  // Turn off all LEDs after the song
  for (int i = 0; i < ledCount; i++) {
    digitalWrite(leds[i], LOW);
  }

  noTone(buzzer);
}

